# 원본 성경/찬송 데이터 (변환 재료 — 웹에는 변환된 JSON만 사용)
bible_data/

# 파이썬 캐시
__pycache__/
*.pyc

# 임시 파일
*.tmp
_*.txt

# 작업 기록 (개인용 — push 제외)
worklog/

# 원어(스트롱) 개인용 사전 — 공개 저장소 제외 (저작권/사적이용)
data/bible/*.dct
data/bible/*.dct-journal
data/bible/*.sdb
data/bible/lexicon_ko.json
# 개인 임포트용 번역본(저작권) — 공개 제외
data/bible/현대인.json
data/bible/새번역.json
data/bible/ESV.json
data/bible/공동번역.json
data/bible/NASB.json
data/bible/BHSStp.json
data/bible/LXXStp.json
data/bible/바른성경.json
# 주석 파일(저작권) — 공개 제외
data/bible/*.cdb
data/bible/*.comm.json
# 원본 성경 DB(변환 재료, 저작권) — 공개 제외
data/bible/*.bdb
